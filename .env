# ── Porta ─────────────────────────────────────────────────────────────────────
PORT=7860

# ── TorBox ────────────────────────────────────────────────────────────────────
# Chave de API da conta TorBox (https://torbox.app → Account → API Key)
TORBOX_API_KEY=your_torbox_api_key_here

# ── Real-Debrid ───────────────────────────────────────────────────────────────
# Chave de API da conta Real-Debrid (https://real-debrid.com/apitoken)
# Deixe vazio se não usar Real-Debrid
RD_API_KEY=

# ── TMDB ──────────────────────────────────────────────────────────────────────
# API Key v3 ou Bearer Token v4 (https://www.themoviedb.org/settings/api)
# Ambos os formatos são aceitos; recomenda-se usar o Bearer Token (Read Access Token)
TMDB_API_KEY=your_tmdb_api_key_or_bearer_token_here

# ── Redis ─────────────────────────────────────────────────────────────────────
# URL de conexão com o Redis (suporta rediss:// para TLS, ex: Upstash)
# Deixe vazio para usar o cache em memória (não recomendado para produção)
REDIS_URL=redis://redis:6379

# Alternativamente, configure host/porta/senha individualmente:
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── Cache TTL ─────────────────────────────────────────────────────────────────
# Tempo de vida do cache de catálogo em segundos (padrão: 3600 = 1h)
CACHE_TTL_CATALOG=3600

# Tempo de vida do cache de streams em segundos (padrão: 21600 = 6h)
CACHE_TTL_STREAM=21600

# ── Segurança ─────────────────────────────────────────────────────────────────
# Segredo exigido pelo endpoint POST /cache/clear global.
# Sem este valor, o endpoint fica desativado.
ADMIN_SECRET=change_me_to_a_random_secret
