# ── Porta ─────────────────────────────────────────────────────────────────────
PORT=7860

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ── Cache TTL ─────────────────────────────────────────────────────────────────
CACHE_TTL_CATALOG=3600
CACHE_TTL_STREAM=21600

# ── Segurança ─────────────────────────────────────────────────────────────────
# Requerido para POST /cache/clear global. Deixe vazio para desativar o endpoint.
ADMIN_SECRET=
